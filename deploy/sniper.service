[Unit]
Description=Telegram contract sniper
After=network-online.target
Wants=network-online.target
# Don't restart-loop forever if the config is broken
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/Telegram-bot
ExecStart=/usr/bin/node /root/Telegram-bot/dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
