# ============ Telegram (get from https://my.telegram.org) ============
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
# Session file name (created on first login)
TELEGRAM_SESSION=sniper

# Comma-separated chat usernames or IDs to listen to.
# Leave empty to listen to EVERY chat your account can see (not recommended).
# Examples: @somegroup,@somechannel,-1001234567890
TARGET_CHATS=

# ============ Safety ============
# true = detect + log what WOULD be bought, but never send a transaction.
# Set to false only when you are ready to trade with real money.
DRY_RUN=true

# Skip buys when the pair's liquidity on DexScreener is below this (USD).
# 0 disables the check. Tokens with no DexScreener listing are also skipped
# unless ALLOW_UNLISTED=true (then chain is resolved by RPC probing).
MIN_LIQUIDITY_USD=5000
ALLOW_UNLISTED=false

# Max slippage in basis points (300 = 3%)
SLIPPAGE_BPS=300

# ============ Wallets ============
# EVM private key (hex, with or without 0x). Used on all EVM chains.
EVM_PRIVATE_KEY=

# Solana private key (base58-encoded secret key, e.g. exported from Phantom)
SOLANA_PRIVATE_KEY=

# ============ Buy amounts (in the chain's native coin) ============
BUY_AMOUNT_ETHEREUM=0.05
BUY_AMOUNT_BSC=0.2
BUY_AMOUNT_BASE=0.05
BUY_AMOUNT_ARBITRUM=0.05
BUY_AMOUNT_POLYGON=50
BUY_AMOUNT_AVALANCHE=1
BUY_AMOUNT_SOLANA=0.25

# ============ RPC endpoints (defaults are public; use your own for speed) ============
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_BSC=https://bsc-dataseed.binance.org
RPC_BASE=https://mainnet.base.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_SOLANA=https://api.mainnet-beta.solana.com
